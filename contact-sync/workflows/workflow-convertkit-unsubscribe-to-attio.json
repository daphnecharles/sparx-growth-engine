    {
      "id": "b4408aaa-7c91-55c5-9fa2-2ee8e5a5dfa2",
      "name": "Map status change",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        280
      ],
      "parameters": {
        "jsCode": "// One webhook URL handles three Kit events; the registered URL carries\n// ?event=unsubscribe|bounce|complain so we know which one fired.\nconst BY_EVENT = { unsubscribe: 'Unsubscribed', bounce: 'Bounced', complain: 'Complained' };\nconst BY_STATE = { cancelled: 'Unsubscribed', bounced: 'Bounced', complained: 'Complained' };\n\nreturn $input.all().map(item => {\n  const body = item.json.body || {};\n  const sub = body.subscriber || {};\n  const email = String(sub.email_address || '').trim().toLowerCase();\n  if (!email) throw new Error('Kit payload had no subscriber.email_address: ' + JSON.stringify(body));\n\n  const event = String((item.json.query || {}).event || '').toLowerCase();\n  const status = BY_EVENT[event] || BY_STATE[String(sub.state || '').toLowerCase()];\n  if (!status) {\n    throw new Error(`Unknown Kit status event \"${event}\" / state \"${sub.state}\": ` + JSON.stringify(body));\n  }\n\n  return {\n    json: {\n      email,\n      email_status: status,\n      // email_status is a single-select, so asserting it directly is safe.\n      attio_assert_body: { data: { values: { email_addresses: [email], email_status: status } } },\n      raw_payload: body,\n    },\n  };\n});\n"
      }
    },
    {
      "id": "21326f9e-4dcc-555b-a3fa-6c35c64d0bcb",
      "name": "Attio: set email_status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        280
      ],
      "parameters": {
        "method": "PUT",
        "url": "https://api.attio.com/v2/objects/people/records",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "matching_attribute",
              "value": "email_addresses"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.attio_assert_body) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "sparxAttioApi",
          "name": "Attio API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "35d323b6-f9fd-5da0-9299-6cc0b1bc6918",
