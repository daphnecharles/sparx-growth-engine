          }
        ]
      ]
    },
    "Kit: add to outbound sequence": {
      "main": [
        [
          {
            "node": "Attio: mark synced_to_convertkit",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Mark failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Attio: mark synced_to_convertkit": {
      "main": [
        [
          {
            "node": "Mark OK",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Mark failed",
            "type": "main",
