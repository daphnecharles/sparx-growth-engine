# Copy to .env and replace every YOUR_* placeholder.  Never commit .env.
#   cp .env.example .env && chmod 600 .env

# ---------------------------------------------------------------------------
# Domain / TLS
# ---------------------------------------------------------------------------
# Subdomain whose DNS A record points at the Oracle VM's public IP,
# e.g. automate.sparxlabs.io (no https://, no trailing slash).
N8N_DOMAIN=YOUR_DOMAIN
# Let's Encrypt sends certificate-expiry warnings here.
ACME_EMAIL=YOUR_ADMIN_EMAIL

# ---------------------------------------------------------------------------
# Login protection (basic auth in front of the n8n editor, enforced by Caddy)
# ---------------------------------------------------------------------------
BASIC_AUTH_USER=sparx
# A bcrypt HASH, not the plain password. Generate it with:
#   docker run --rm caddy:2.11.7 caddy hash-password --plaintext 'the-real-password'
# Keep the single quotes — the hash contains "$" characters.
BASIC_AUTH_HASH='YOUR_BCRYPT_HASH'

# ---------------------------------------------------------------------------
# n8n
# ---------------------------------------------------------------------------
# Encrypts all credentials n8n stores. Generate once with:  openssl rand -hex 32
# Store a copy in the team password manager — without it, a restored backup
# cannot decrypt its credentials.
N8N_ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY
# IANA time zone used for schedules and execution timestamps.
TIMEZONE=America/New_York

# ---------------------------------------------------------------------------
# Workflow configuration (not secrets — API keys go in n8n's credential manager)
# ---------------------------------------------------------------------------
# Random token appended to the Kit webhook URLs (?token=...). Requests without it
# are rejected. Generate with:  openssl rand -hex 24
WEBHOOK_SHARED_SECRET=YOUR_WEBHOOK_SHARED_SECRET
# Numeric ID of the Kit sequence that "Send Outbound" contacts are added to.
# Find it in the URL when editing the sequence in Kit: app.kit.com/sequences/<ID>
KIT_SEQUENCE_ID=YOUR_KIT_SEQUENCE_ID
# Comma-separated addresses that appear in Substack notification emails but are
# NOT subscribers (the Sparx Signal publisher/owner address, the Gmail inbox
# receiving the notifications, etc.). The Substack parser ignores these.
SUBSTACK_PUBLISHER_EMAILS=YOUR_PUBLISHER_EMAIL,YOUR_NOTIFICATIONS_GMAIL
